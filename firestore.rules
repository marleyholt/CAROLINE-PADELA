rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Procedimentos: Leitura e escrita completas para catálogo de serviços
    match /procedimentos/{procId} {
      allow read, write: if true;
    }
    
    // Configurações da clínica e Pix Inter
    match /configuracoes/{configId} {
      allow read, write: if true;
    }
    
    // Agendamentos: Paciente cria e consulta pelo portal; terapeuta gerencia no CRM
    match /agendamentos/{agendamentoId} {
      allow read, write: if true;
    }
    
    // Pacientes e Prontuário CRM: Cadastro no agendamento e gerenciamento pelo terapeuta
    match /pacientes/{pacienteId} {
      allow read, write: if true;
    }
    
    // Evoluções Clínicas e Anamnese
    match /evolucoes/{evolucaoId} {
      allow read, write: if true;
    }
    
    // Transações Financeiras, Custos e Controle de Pacotes
    match /financeiro/{transacaoId} {
      allow read, write: if true;
    }
    
    // Pacotes de Sessões de Pacientes (Pagas vs Realizadas)
    match /pacotes_sessoes/{pacoteId} {
      allow read, write: if true;
    }
    
    // Gerenciamento de Acessos de Usuários e Terapeutas
    match /usuarios_acesso/{usuarioId} {
      allow read, write: if true;
    }
  }
}
